{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/[...slug].js": {
      "maxDuration": 10
    }
  }
  ,
  "rewrites": [
    { "source": "/docs/:match*", "destination": "/api/docs/:match*" },
    { "source": "/docs", "destination": "/api/docs" }
  ]
}
